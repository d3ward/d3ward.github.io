---
import { Icon } from "astro-icy/components";

// CSS grid placement class is `gs-${area}` — must match grid-template-areas in styles.css
interface Props {
  area: string;
  colorClass?: string;
  value?: string | number;
  label?: string;
  icon?: string;
  href?: string;
  animation?: "left" | "right" | "top" | "bottom";
  showLabelOnMobile?: boolean;
  noJsValue?: string | number;
  tilt?: boolean;
  tiltMax?: number;
  tiltSpeed?: number;
  tiltPerspective?: number;
}

const {
  area,
  colorClass = "",
  value = "",
  label = "",
  icon,
  href,
  animation = "bottom",
  showLabelOnMobile = true,
  noJsValue,
  tilt = true,
  tiltMax = 15,
  tiltSpeed = 400,
  tiltPerspective = 1000,
} = Astro.props;

const isLogo = area === "logo";
const isLink = !!href;

const Tag = href ? "a" : "div";
const linkAttrs = href ? { href, target: "_blank", "aria-label": label } : {};
const tiltAttrs = tilt
  ? {
      "data-tilt": "",
      "data-tilt-max": tiltMax,
      "data-tilt-speed": tiltSpeed,
      "data-tilt-perspective": tiltPerspective,
    }
  : {};
---

<Tag
  class:list={[
    `gs-${area}`,
    colorClass,
    "relative flex flex-col items-center justify-center overflow-hidden rounded-lg p-4 text-center transition-all duration-700",
    animation &&
      {
        left: "_aos-left",
        right: "_aos-right",
        top: "_aos-top",
        bottom: "_aos-bottom",
      }[animation],
  ]}
  {...linkAttrs}
  {...tiltAttrs}
>
  <span class="gs-ripple"></span>

  {
    isLogo ? (
      <div class="z-10">
        <slot />
      </div>
    ) : isLink ? (
      <div class="z-10">
        <Icon
          name="tabler:external-link"
          class="absolute top-2 right-2 z-10 h-6 w-6"
        />
        {icon && <Icon name={icon} size="xl" />}
        <slot />
      </div>
    ) : (
      <div class="z-10 flex flex-col items-center">
        {noJsValue && (
          <span class="no-js mb-2 text-3xl leading-none font-medium">
            {noJsValue}
          </span>
        )}
        {value && (
          <span
            class="mb-2 text-3xl leading-none font-medium"
            data-count-target={value}
          >
            {value}
          </span>
        )}
        {label && (
          <label class="flex items-center justify-center gap-1 text-base font-medium">
            {icon && <Icon name={icon} />}
            <span class:list={[!showLabelOnMobile && "hidden md:block"]}>
              {label}
            </span>
          </label>
        )}
      </div>
    )
  }
</Tag>
