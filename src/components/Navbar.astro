---
import { Button, ThemeController } from "@icy/ui/components";
import { Icon } from "@icy/icon/components";
import { navItems } from "@data/nav";
import { THEMES } from "@data/theme";

const currentPath = Astro.url.pathname;
---

<!-- ============ TOP NAVBAR ============ -->
<header class="fixed top-0 right-0 left-0 z-50 transition-all" id="main-header">
  <div class="navbar-wrap mx-auto max-w-5xl px-4 py-3">
    <div class="navbar bg-base-100 h-14 min-h-0 rounded-2xl p-1.5">
      <!-- Logo -->
      <div class="navbar-start">
        <a
          href="/"
          class="btn btn-ghost btn-square text-primary gap-2 text-xl"
          aria-label="Home"
        >
          <Icon name="local:d3" class="text-primary" />
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
          {
            navItems.map((item) => (
              <li class="ml-1.5">
                <Button
                  href={item.href}
                  style="ghostLine"
                  class:list={[
                    "nav-link",
                    currentPath === item.href && "btn-active nav-link-active",
                  ]}
                  icon={item.icon}
                >
                  {item.label}
                </Button>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right Side Actions -->
      <div class="navbar-end gap-2">
        <!-- Support Button (desktop only) -->
        <Button
          style="ghost"
          square={true}
          icon="tabler:coffee"
          data-modal-open="support_dialog"
          aria-label="Support me"
          class="hidden lg:inline-flex"
        />

        <!-- GitHub Link (desktop only) -->
        <Button
          href="https://github.com/d3ward"
          external={true}
          style="ghost"
          square={true}
          icon="simple-icons:github"
          aria-label="GitHub Profile"
          class="hidden lg:inline-flex"
        />

        <!-- Theme Toggle (desktop only) -->
        <ThemeController themes={THEMES} class="hidden lg:flex" />

        <!-- Mobile hamburger -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="btn btn-ghost btn-square lg:hidden"
          aria-label="Menu"
          aria-expanded="false"
        >
          <span class="swap swap-rotate" id="menu-icon-swap">
            <Icon name="tabler:menu-2" class="swap-off h-5 w-5" />
            <Icon name="tabler:x" class="swap-on h-5 w-5" />
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- ============ MOBILE DRAWER CARD ============ -->
<div
  class="mobile-drawer fixed top-22 right-0 left-0 z-50 mx-4 lg:hidden"
  id="mobile-drawer-card"
  aria-hidden="true"
  inert
>
  <div
    class="bg-base-100/95 border-base-300/50 mx-auto max-w-5xl rounded-2xl border p-2 shadow-lg backdrop-blur"
  >
    <!-- Nav links -->
    <ul class="menu w-full">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[currentPath === item.href && "active"]}
            >
              <Icon name={item.icon} />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="divider my-1"></div>

    <!-- Extra actions -->
    <div class="flex items-center gap-1 px-1">
      <button
        type="button"
        data-modal-open="support_dialog"
        class="btn btn-ghost btn-sm flex-1 gap-2"
      >
        <Icon name="tabler:coffee" />
        <span>Support</span>
      </button>

      <a
        href="https://github.com/d3ward"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost btn-sm flex-1 gap-2"
      >
        <Icon name="simple-icons:github" />
        <span>GitHub</span>
      </a>

      <!-- Mobile Theme Toggle -->
      <ThemeController themes={THEMES} size="sm" />
    </div>
  </div>
</div>

<script>
  import { withLifecycle } from "@scripts/lifecycle";
  import { initNavbar } from "@scripts/navbar";

  withLifecycle(initNavbar);
</script>

<style is:global>
  .navbar-center .nav-link {
    position: relative;
    transition: color 0.2s ease;
  }

  .navbar-center .nav-link:hover,
  .navbar-center .nav-link:focus-visible,
  .navbar-center .nav-link.nav-link-active {
    color: var(--color-primary);
  }

  .navbar-center .nav-link::after {
    content: "";
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .navbar-center .nav-link:hover::after,
  .navbar-center .nav-link:focus-visible::after,
  .navbar-center .nav-link.nav-link-active::after {
    transform: scaleX(1);
  }

  .mobile-drawer {
    transition:
      opacity 0.2s ease-out,
      translate 0.2s ease-out;
  }

  .mobile-drawer[aria-hidden="true"] {
    opacity: 0;
    translate: 0 -0.5rem;
    pointer-events: none;
  }

  .mobile-drawer[aria-hidden="false"] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
</style>
