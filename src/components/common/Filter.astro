---
import Button from "./Button.astro";

export interface FilterOption {
  id: string;
  label: string;
  icon?: string;
}

interface Props {
  options: FilterOption[];
  activeFilter?: string;
  class?: string;
  size?: "xs" | "sm" | "md" | "lg";
}

const {
  options,
  activeFilter = "all",
  class: className = "",
  size = "sm",
} = Astro.props;
---

<div class={`filter ${className}`}>
  {
    options.map((option: FilterOption) => (
      <Button
        type="button"
        color="primary"
        style="soft"
        size={size}
        active={option.id === activeFilter}
        icon={option.icon}
        iconClass="h-4 w-4"
        class="gap-2"
        data-filter={option.id}
        aria-label={option.label}
        aria-pressed={option.id === activeFilter}
      >
        {option.label}
      </Button>
    ))
  }
</div>

<script>
  import { withLifecycle } from "@scripts/lifecycle";
  import { applyFilter } from "@scripts/filter-engine";

  function updateButtonStyles(
    buttons: NodeListOf<Element>,
    activeFilter: string,
  ) {
    buttons.forEach((btn) => {
      const isActive = btn.getAttribute("data-filter") === activeFilter;
      btn.classList.toggle("btn-active", isActive);
      btn.setAttribute("aria-pressed", String(isActive));
    });
  }

  withLifecycle(() => {
    const buttons = document.querySelectorAll("[data-filter]");
    if (buttons.length === 0) return;

    buttons.forEach((button) => {
      button.addEventListener("click", (e) => {
        e.preventDefault();
        const value =
          (e.currentTarget as HTMLElement).getAttribute("data-filter") || "all";
        updateButtonStyles(buttons, value);
        applyFilter(value);
      });
    });
  });
</script>

<style>
  :global(.grid [data-groups]),
  :global(.grid [data-filters]) {
    width: calc(100% / 3);
    padding: 0.75rem;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    :global(.grid [data-groups]),
    :global(.grid [data-filters]) {
      width: 50%;
    }
  }

  @media (max-width: 480px) {
    :global(.grid [data-groups]),
    :global(.grid [data-filters]) {
      width: 100%;
    }
  }

  :global(.shuffle-item--hidden) {
    opacity: 0;
    pointer-events: none;
  }

  :global(.shuffle-item--visible) {
    opacity: 1;
  }
</style>
